    "native_config": "runtime:\n  worker_threads: 2\napi:\n  http:\n    listen: 127.0.0.1:9199\nlog:\n  level: info\nplugins:\n- tag: lazy_cache\n  type: cache\n  args:\n    size: 10240\n    lazy_cache_ttl: 300\n    short_circuit: true\n- tag: local_probe_cache\n  type: cache\n  args:\n    size: 2048\n    short_circuit: false\n- tag: forward_local\n  type: forward\n  args:\n    concurrent: 2\n    upstreams:\n    - addr: udp://223.5.5.5\n    - addr: udp://119.29.29.29\n- tag: forward_remote\n  type: forward\n  args:\n    concurrent: 1\n    upstreams:\n    - addr: https://1.1.1.1/dns-query\n    - addr: https://8.8.8.8/dns-query\n- tag: china_dns\n  type: sequence\n  args:\n  - exec: $lazy_cache\n  - exec: $forward_local\n  - matches:\n    - '!has_resp'\n    exec: reject 3\n- tag: local_probe\n  type: sequence\n  args:\n  - exec: $local_probe_cache\n  - matches:\n    - '!has_resp'\n    exec: $forward_local\n  - exec: return\n- tag: remote_dns\n  type: sequence\n  args:\n  - exec: $forward_remote\n  - matches:\n    - '!has_resp'\n    exec: reject 3\n  - exec: ttl 1\n- tag: proxy_dns_seq\n  type: sequence\n  args:\n  - exec: goto remote_dns\n- tag: default_direct_ip\n  type: sequence\n  args:\n  - exec: accept\n- tag: direct_ip\n  type: sequence\n  args:\n  - exec: accept\n- tag: ip_requery_proxy\n  type: sequence\n  args:\n  - exec: drop_resp\n  - exec: goto proxy_dns_seq\n- tag: sequence_main\n  type: sequence\n  args:\n  - exec: metrics_collector metrics\n  - exec: prefer_ipv4\n  - matches:\n    - qtype 65 255\n    exec: black_hole nodata short_circuit=true\n  - exec: goto proxy_dns_seq\n- tag: server_udp\n  type: udp_server\n  args:\n    listen: 0.0.0.0:53\n    entry: sequence_main\n- tag: server_tcp\n  type: tcp_server\n  args:\n    listen: 0.0.0.0:53\n    entry: sequence_main\n",
