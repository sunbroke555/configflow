{
  "profile_id": "golden-space",
  "profile_name": "兼容基线",
  "nodes": [],
  "subscriptions": [],
  "subscription_aggregations": [],
  "rule_library": [],
  "system_config": {
    "server_domain": "https://config.test",
    "rule_proxy_token": "fixture-token"
  },
  "proxy_groups": [
    {
      "id": "pg_main",
      "name": "节点选择",
      "type": "select",
      "manual_nodes": [
        "DIRECT"
      ]
    }
  ],
  "rule_configs": [
    {
      "id": "r_allow",
      "itemType": "rule",
      "rule_type": "DOMAIN-SUFFIX",
      "value": "example.test",
      "policy": "节点选择"
    },
    {
      "id": "r_refused",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "refused.example.test",
      "policy": "REJECT"
    },
    {
      "id": "r_nxdomain",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "missing.example.test",
      "policy": "REJECT"
    },
    {
      "id": "r_nodata",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "empty.example.test",
      "policy": "REJECT-DROP"
    },
    {
      "id": "r_blackhole",
      "itemType": "rule",
      "rule_type": "DOMAIN-KEYWORD",
      "value": "ads",
      "policy": "REJECT"
    },
    {
      "id": "r_pinned",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "pinned.example.test",
      "policy": "DIRECT"
    },
    {
      "id": "r_ip",
      "itemType": "rule",
      "rule_type": "IP-CIDR",
      "value": "192.0.2.0/24",
      "policy": "DIRECT",
      "no_resolve": true
    },
    {
      "id": "r_ip6",
      "itemType": "rule",
      "rule_type": "IP-CIDR6",
      "value": "2001:db8::/32",
      "policy": "节点选择",
      "no_resolve": true
    },
    {
      "id": "r_off",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "disabled.example.test",
      "policy": "REJECT",
      "enabled": false
    },
    {
      "id": "r_lib_off",
      "itemType": "ruleset",
      "name": "disabled-library",
      "behavior": "domain",
      "url": "https://rules.test/disabled.yaml",
      "policy": "REJECT",
      "library_enabled": false
    },
    {
      "id": "rs_ads",
      "itemType": "ruleset",
      "name": "广告规则",
      "behavior": "domain",
      "url": "https://rules.test/ads.yaml",
      "policy": "REJECT"
    },
    {
      "id": "rs_mixed",
      "itemType": "ruleset",
      "name": "mixed",
      "behavior": "classical",
      "url": "https://rules.test/mixed.yaml",
      "policy": "节点选择",
      "no_resolve": true
    },
    {
      "id": "rs_ip",
      "itemType": "ruleset",
      "name": "networks",
      "behavior": "ipcidr",
      "url": "https://rules.test/networks.txt",
      "policy": "DIRECT",
      "no_resolve": true
    },
    {
      "id": "r_match_off",
      "itemType": "rule",
      "rule_type": "MATCH",
      "policy": "REJECT",
      "enabled": false
    },
    {
      "id": "r_match",
      "itemType": "rule",
      "rule_type": "MATCH",
      "policy": "节点选择"
    },
    {
      "id": "r_after",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "after.example.test",
      "policy": "REJECT"
    }
  ],
  "oxidns": {
    "rule_actions": {
      "r_refused": {
        "action": "refused"
      },
      "r_nxdomain": {
        "action": "nxdomain"
      },
      "r_nodata": {
        "action": "nodata"
      },
      "r_blackhole": {
        "action": "blackhole"
      },
      "rs_ads": {
        "action": "blackhole"
      },
      "r_pinned": {
        "action": "upstream",
        "source": "remote",
        "upstream": {
          "addr": "udp://9.9.9.9"
        }
      }
    },
    "rule_dns_follow": [
      "r_allow",
      "r_ip",
      "r_ip6",
      "rs_mixed",
      "rs_ip",
      "r_after"
    ],
    "local_dns": "udp://192.168.50.53",
    "remote_dns": "udp://9.9.9.9",
    "fallback_dns": "udp://1.1.1.1",
    "cache_enabled": true,
    "probe_cache_enabled": true,
    "cache_lazy_ttl": 60,
    "remote_ttl": 120,
    "query_recorder": {
      "enabled": true
    },
    "custom_hosts": "full:nas.test 192.168.50.2",
    "custom_matches": [
      {
        "matches": "qname domain:custom.test",
        "exec": "goto china_dns"
      }
    ],
    "custom_match_position": "head",
    "custom_config": "custom_extension:\n  保留: true\nplugins:\n  - tag: custom_passthrough\n    type: sequence\n    args:\n      - exec: return\n"
  },
  "mosdns": {
    "direct_rules": [
      "r_pinned",
      "r_ip"
    ],
    "proxy_rules": [
      "r_allow",
      "r_ip6"
    ],
    "direct_rulesets": [
      "rs_ip"
    ],
    "proxy_rulesets": [
      "rs_mixed"
    ],
    "custom_hosts": "nas.test 192.168.50.2",
    "local_dns": "udp://192.168.50.53",
    "remote_dns": "udp://9.9.9.9",
    "cache_enabled": true,
    "custom_config": "log: {level: warn}\ncustom_extension: {keep: true}\n"
  },
  "mihomo": {
    "custom_config": "mixed-port: 7890\nallow-lan: true\nmode: rule\ndns: {enable: false}\ncustom-extension: {keep: true}\nsub-rules:\n  lan-rules: [\"MATCH,DIRECT\"]\n"
  },
  "surge": {
    "custom_config": "[General]\nloglevel = notify\n[Host]\nnas.test = 192.168.50.2\n"
  },
  "loon": {
    "custom_config": "[General]\nloglevel = notify\n[Host]\nnas.test = 192.168.50.2\n"
  }
}
