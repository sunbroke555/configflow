{
  "system_config": {
    "rule_proxy_token": "fixture-token",
    "server_domain": "https://config.test"
  },
  "oxidns": {
    "direct_rules": [
      "d1",
      "d3",
      "i1",
      "off"
    ],
    "proxy_rules": [
      "d2",
      "i2"
    ],
    "direct_rulesets": [
      "s1"
    ],
    "proxy_rulesets": [
      "s2",
      "s3"
    ],
    "custom_matches": [
      {
        "matches": "qname domain:corp.test",
        "exec": "goto china_dns"
      }
    ],
    "custom_match_position": "head",
    "custom_hosts": "full:nas.test 192.168.1.2",
    "block_qtypes": [],
    "cache_enabled": false,
    "probe_cache_enabled": false,
    "prefer_ipv4": false,
    "metrics_enabled": false,
    "tcp_enabled": false,
    "remote_ttl": 0,
    "ros_route": {
      "enabled": true,
      "args": {
        "address": "192.168.88.1",
        "username": "u",
        "password": "p",
        "routing_table": "proxy",
        "gateway4": "10.0.0.1"
      }
    }
  },
  "rule_configs": [
    {
      "id": "d1",
      "itemType": "rule",
      "rule_type": "DOMAIN-SUFFIX",
      "value": "example.test",
      "enabled": true
    },
    {
      "id": "d2",
      "itemType": "rule",
      "rule_type": "DOMAIN",
      "value": "x.example.test",
      "enabled": true
    },
    {
      "id": "d3",
      "itemType": "rule",
      "rule_type": "DOMAIN-KEYWORD",
      "value": "ads",
      "enabled": true
    },
    {
      "id": "i1",
      "itemType": "rule",
      "rule_type": "IP-CIDR",
      "value": "203.0.113.0/24",
      "enabled": true
    },
    {
      "id": "i2",
      "itemType": "rule",
      "rule_type": "IP-CIDR6",
      "value": "2001:db8::/32",
      "enabled": true
    },
    {
      "id": "g1",
      "itemType": "rule",
      "rule_type": "GEOIP",
      "value": "CN",
      "enabled": true
    },
    {
      "id": "off",
      "itemType": "rule",
      "rule_type": "DOMAIN-SUFFIX",
      "value": "off.test",
      "enabled": false
    },
    {
      "id": "s1",
      "name": "cn",
      "itemType": "ruleset",
      "behavior": "domain",
      "url": "https://rules.test/cn"
    },
    {
      "id": "s2",
      "name": "mixed",
      "itemType": "ruleset",
      "behavior": "classical",
      "url": "/api/rule-library/content/s2"
    },
    {
      "id": "s3",
      "name": "ips",
      "itemType": "ruleset",
      "behavior": "ipcidr",
      "url": "https://rules.test/ip"
    }
  ],
  "mosdns": {
    "direct_rules": [
      "d1",
      "d3",
      "i1",
      "off"
    ],
    "proxy_rules": [
      "d2",
      "i2"
    ],
    "direct_rulesets": [
      "s1"
    ],
    "proxy_rulesets": [
      "s2",
      "s3"
    ],
    "block_qtypes": [],
    "cache_enabled": false,
    "prefer_ipv4": false
  }
}
